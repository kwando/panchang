---
version: 1.5.5
title: icalendar_multiple_timezones
---
VCALENDAR
  VERSION: "2.0"
  BEGIN:VTIMEZONE
    TZID: "America/New_York"
    BEGIN:STANDARD
      TZNAME: "EST"
      TZOFFSETFROM: "-0400"
      TZOFFSETTO: "-0500"
      DTSTART: "19671029T020000"
      RRULE: "FREQ=YEARLY;BYDAY=-1SU;BYMONTH=10"
    END:STANDARD
    BEGIN:DAYLIGHT
      TZNAME: "EDT"
      TZOFFSETFROM: "-0500"
      TZOFFSETTO: "-0400"
      DTSTART: "19870405T020000"
      RRULE: "FREQ=YEARLY;BYDAY=1SU;BYMONTH=4"
    END:DAYLIGHT
  END:VTIMEZONE
  BEGIN:VEVENT
    UID: "test-vtime-named-timezone"
    DTSTART
      TZID: "America/New_York"
      value: "20210302T000000"
    RDATE
      VALUE: "TIME"
      TZID: "America/New_York"
      value: "083000"
  END:VEVENT
  BEGIN:VEVENT
    UID: "test-vtime-utc"
    DTSTART: "20210302T000000Z"
    RDATE
      VALUE: "TIME"
      value: "133000Z"
  END:VEVENT
  BEGIN:VEVENT
    UID: "test-vtime-floating"
    DTSTART: "20210302T000000"
    RDATE
      VALUE: "TIME"
      value: "083000"
  END:VEVENT
